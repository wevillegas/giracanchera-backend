{
  "name": "giracanchera-back",
  "version": "1.0.0",
  "description": "GiraCanchera backend API (Express + PostgreSQL/Prisma)",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon --exec \"node --import dotenv/config --import ./src/config/sentry.js src/server.js\"",
    "start": "node --import dotenv/config --import ./src/config/sentry.js src/server.js",
    "seed": "node src/utils/seed.js",
    "seed:users": "node src/utils/seedUsers.js",
    "import:wikidata": "node src/utils/importWikidata.js",
    "test": "node --test \"src/**/*.test.js\"",
    "postinstall": "prisma generate",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "backup:mongo": "node migration/backup-mongo.js",
    "snapshot": "node migration/snapshot-api.js",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:studio": "prisma studio",
    "db:deploy": "prisma migrate deploy",
    "migrate:data": "node migration/migrate-data.js",
    "backup:db": "node scripts/backup-db.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wevillegas/giracanchera-backend.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/wevillegas/giracanchera-backend/issues"
  },
  "homepage": "https://github.com/wevillegas/giracanchera-backend#readme",
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@sentry/node": "11.8.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0",
    "multer-storage-cloudinary": "^4.0.0",
    "pg": "8.23.1",
    "prisma": "7.10.1"
  },
  "devDependencies": {
    "mongoose": "^9.10.0",
    "nodemon": "^3.1.14"
  },
  "overrides": {
    "multer-storage-cloudinary": {
      "cloudinary": "$cloudinary"
    }
  },
  "engines": {
    "node": ">=22.18"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true
  }
}
