NODE_ENV=development
PORT=5000
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
FRONTEND_URL=http://localhost:5173
JWT_SECRET=
# true si el servidor está detrás de un proxy (Render, Railway, Nginx): necesario para que el rate limit use la IP real
TRUST_PROXY=false
# Producción con Vercel (rewrite) + Render: TRUST_PROXY=2
# PostgreSQL: local con docker compose (puerto 5433); en producción, la cadena de conexión de Neon
DATABASE_URL=postgresql://giracanchera:giracanchera@localhost:5433/giracanchera_dev
TEST_DATABASE_URL=postgresql://giracanchera:giracanchera@localhost:5433/giracanchera_test
# Producción (Neon): DATABASE_URL = cadena con pooling (-pooler) y DATABASE_URL_UNPOOLED = cadena directa (la usan las
# migraciones de Prisma). Usar sslmode=verify-full. En local, DATABASE_URL_UNPOOLED no hace falta.
# DATABASE_URL_UNPOOLED=
# Solo para el script de respaldo de la migración desde Mongo (migration/backup-mongo.js)
# MONGODB_URI=mongodb://localhost:27017/giracanchera
# Ensayo y corte de la migración en Neon (los usa quien migra, no la app)
# NEON_DATABASE_URL=postgresql://usuario:clave@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require
# NEON_DATABASE_URL_UNPOOLED=postgresql://usuario:clave@ep-xxxx.region.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require
